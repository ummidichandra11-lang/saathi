# Saathi Environment Configuration

# Anthropic Claude API Key (Required for live AI inference)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model identifier (Configurable, defaults to claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase Postgres Configuration (Optional - embedded full dataset fallback is active)
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
